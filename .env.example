# Printy backend — production-safe template (see docs/env_vars.md).
# Copy to .env and fill in real values. NEVER commit the real .env.

# --- Core / security ---
SECRET_KEY=replace-with-long-random-secret
DEBUG=false
ALLOWED_HOSTS=api.printy.ke,printy.ke,www.printy.ke

# --- Site / auth links ---
SITE_DOMAIN=printy.ke
SITE_NAME=Printy
FRONTEND_URL=https://printy.ke

# --- CORS / CSRF (HTTPS origins required when DEBUG=false) ---
CORS_ALLOWED_ORIGINS=https://printy.ke,https://www.printy.ke
CSRF_TRUSTED_ORIGINS=https://printy.ke,https://www.printy.ke,https://api.printy.ke

# --- Database (PostgreSQL) ---
DB_NAME=printy_prod
DB_USER=replace-with-db-user
DB_PASSWORD=replace-with-db-password
DB_HOST=127.0.0.1
DB_PORT=5432

# --- Email / SMTP ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=replace-with-smtp-user
EMAIL_HOST_PASSWORD=replace-with-smtp-password
DEFAULT_FROM_EMAIL=Printy <hello@printy.ke>
ADMIN_NOTIFY_EMAIL=ops@printy.ke
ACCOUNT_EMAIL_VERIFICATION=mandatory

# --- Security flags ---
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
SECURE_HSTS_PRELOAD=false

# --- M-Pesa / Daraja (production) ---
MPESA_ENV=production
MPESA_CONSUMER_KEY=replace-with-prod-consumer-key
MPESA_CONSUMER_SECRET=replace-with-prod-consumer-secret
MPESA_SHORTCODE=replace-with-prod-shortcode
MPESA_SHORTCODE_TYPE=paybill
MPESA_PASSKEY=replace-with-prod-passkey
MPESA_CALLBACK_URL=https://api.printy.ke/api/payments/mpesa/callback/
MPESA_TIMEOUT_SECONDS=30
MPESA_ACCOUNT_REFERENCE_DEFAULT=PRINTY
MPESA_TRANSACTION_DESC_DEFAULT=Printy payment

# --- Optional OAuth ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=