# Printy backend — production-safe template (see docs/env_vars.md).
# Copy to .env and fill in real values. NEVER commit the real .env.

# --- Core / security ---
SECRET_KEY=replace-with-long-random-secret
DEBUG=false
# REQUIRED on any server. The email guard (printy.E001) treats an unset APP_ENV
# as production: forgetting EMAIL_BACKEND then fails startup instead of letting
# emails silently print to the console.
APP_ENV=production
# REQUIRED when DEBUG=false: there is no default. Startup fails if it is
# unset, empty, contains "*" or lists only local names (audit #10b).
ALLOWED_HOSTS=api.printy.ke,printy.ke,www.printy.ke

# --- Site / auth links ---
SITE_DOMAIN=printy.ke
SITE_NAME=Printy
FRONTEND_URL=https://printy.ke

# --- CORS / CSRF (HTTPS origins required when DEBUG=false) ---
CORS_ALLOWED_ORIGINS=https://printy.ke,https://www.printy.ke
CSRF_TRUSTED_ORIGINS=https://printy.ke,https://www.printy.ke,https://api.printy.ke

# --- Database (PostgreSQL) ---
DB_NAME=printy_prod
DB_USER=replace-with-db-user
DB_PASSWORD=replace-with-db-password
DB_HOST=127.0.0.1
DB_PORT=5432

# --- Cache (Redis) ---
# REQUIRED when DEBUG=false (audit #10b): every throttle counter (login, OTP,
# guest uploads, tracking lookups...) and the Daraja OAuth token live here and
# must be shared by all gunicorn workers. Startup fails without it.
REDIS_URL=redis://127.0.0.1:6379/1

# --- Email / SMTP ---
# REQUIRED in production. If this is left unset the code falls back to the
# CONSOLE backend and every email is only printed to the server console —
# exactly the "works in console, never arrives" bug. The startup check
# printy.E001 blocks that in non-local environments.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=replace-with-smtp-user
EMAIL_HOST_PASSWORD=replace-with-smtp-password
DEFAULT_FROM_EMAIL=Printy <hello@printy.ke>
ADMIN_NOTIFY_EMAIL=ops@printy.ke
ACCOUNT_EMAIL_VERIFICATION=mandatory
# Verify delivery after deploying: manage.py send_test_email --to you@example.com

# --- Security flags ---
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
SECURE_HSTS_PRELOAD=false

# --- M-Pesa / Daraja (production) ---
# Required. The startup check printy.E013–E016 fails `manage.py check` on
# purpose until the four SECRET values below are real values from the Daraja
# portal (production app). MPESA_BASE_URL is derived from MPESA_ENV when unset.
MPESA_ENV=production
MPESA_CONSUMER_KEY=replace-with-prod-consumer-key
MPESA_CONSUMER_SECRET=replace-with-prod-consumer-secret
# Daraja product the app is provisioned for: paybill | till | buygoodsonline.
MPESA_SHORTCODE_TYPE=paybill
# paybill/till only: leave both empty for buygoodsonline.
MPESA_SHORTCODE=replace-with-prod-shortcode
MPESA_PASSKEY=replace-with-prod-passkey
MPESA_CALLBACK_URL=https://api.printy.ke/api/payments/mpesa/callback/
# REQUIRED when DEBUG=False (startup fails otherwise). Daraja callbacks are
# unsigned; this secret is appended to every URL we register with Daraja and
# checked on every callback. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
MPESA_CALLBACK_SECRET=replace-with-random-callback-secret
# Optional override of the Safaricom callback source IPs enforced in production.
# MPESA_CALLBACK_ALLOWED_IPS=196.201.214.200,196.201.214.206,196.201.213.114
# Reverse proxies whose X-Forwarded-For is trusted (default: loopback nginx).
# Audit #10b: this one setting governs EVERY client-IP decision (callback
# allowlist, all throttles, client-portal and consent records, analytics).
# Do not set NUM_PROXIES; it is ignored (system check printy.W903).
# MPESA_TRUSTED_PROXIES=127.0.0.1,::1
MPESA_TIMEOUT_SECONDS=30
MPESA_ACCOUNT_REFERENCE_DEFAULT=PRINTY
# Daraja rejects the whole STK request if this exceeds 13 characters.
MPESA_TRANSACTION_DESC_DEFAULT=Printy Order
# For future B2C / reversal / status flows (optional, leave empty for now):
# MPESA_INITIATOR_NAME=
# MPESA_INITIATOR_PASSWORD=
# MPESA_SECURITY_CREDENTIAL=
# MPESA_TIMEOUT_URL=https://api.printy.ke/api/payments/mpesa/timeout/
# MPESA_RESULT_URL=https://api.printy.ke/api/payments/mpesa/result/

# --- Optional OAuth ---
# Required for POST /api/auth/social/google/ (audit #4): the ID token's audience
# must equal this OAuth client id (comma-separate several, e.g. web,android).
# Unset => Google login returns 503 (fails closed).
# GOOGLE_CLIENT_ID=
# Dev/test ONLY: skip the audience check when GOOGLE_CLIENT_ID is unset. Ignored
# unless DEBUG=true and APP_ENV is local/dev/test.
# GOOGLE_OAUTH_DEV_SKIP_AUDIENCE=false
# Auth throttle overrides (defaults in config/settings.py), e.g.:
# THROTTLE_RATE_AUTH_LOGIN=10/min
# THROTTLE_RATE_AUTH_REGISTER=10/hour
# THROTTLE_RATE_AUTH_PASSWORD_RESET=5/hour
# THROTTLE_RATE_AUTH_GOOGLE_LOGIN=20/min
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=