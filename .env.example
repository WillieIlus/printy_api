# Printy backend — production-safe template (see docs/env_vars.md).
# Copy to .env and fill in real values. NEVER commit the real .env.

# --- Core / security ---
SECRET_KEY=replace-with-long-random-secret
DEBUG=false
# REQUIRED on any server. The email guard (printy.E001) treats an unset APP_ENV
# as production: forgetting EMAIL_BACKEND then fails startup instead of letting
# emails silently print to the console.
APP_ENV=production
ALLOWED_HOSTS=api.printy.ke,printy.ke,www.printy.ke

# --- Site / auth links ---
SITE_DOMAIN=printy.ke
SITE_NAME=Printy
FRONTEND_URL=https://printy.ke

# --- CORS / CSRF (HTTPS origins required when DEBUG=false) ---
CORS_ALLOWED_ORIGINS=https://printy.ke,https://www.printy.ke
CSRF_TRUSTED_ORIGINS=https://printy.ke,https://www.printy.ke,https://api.printy.ke

# --- Database (PostgreSQL) ---
DB_NAME=printy_prod
DB_USER=replace-with-db-user
DB_PASSWORD=replace-with-db-password
DB_HOST=127.0.0.1
DB_PORT=5432

# --- Email / SMTP ---
# REQUIRED in production. If this is left unset the code falls back to the
# CONSOLE backend and every email is only printed to the server console —
# exactly the "works in console, never arrives" bug. The startup check
# printy.E001 blocks that in non-local environments.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=replace-with-smtp-user
EMAIL_HOST_PASSWORD=replace-with-smtp-password
DEFAULT_FROM_EMAIL=Printy <hello@printy.ke>
ADMIN_NOTIFY_EMAIL=ops@printy.ke
ACCOUNT_EMAIL_VERIFICATION=mandatory
# Verify delivery after deploying: manage.py send_test_email --to you@example.com

# --- Security flags ---
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
SECURE_HSTS_PRELOAD=false

# --- M-Pesa / Daraja (production) ---
# Required. The startup check printy.E013–E016 fails `manage.py check` on
# purpose until the four SECRET values below are real values from the Daraja
# portal (production app). MPESA_BASE_URL is derived from MPESA_ENV when unset.
MPESA_ENV=production
MPESA_CONSUMER_KEY=replace-with-prod-consumer-key
MPESA_CONSUMER_SECRET=replace-with-prod-consumer-secret
MPESA_SHORTCODE=replace-with-prod-shortcode
MPESA_SHORTCODE_TYPE=paybill
MPESA_PASSKEY=replace-with-prod-passkey
MPESA_CALLBACK_URL=https://api.printy.ke/api/payments/mpesa/callback/
MPESA_TIMEOUT_SECONDS=30
MPESA_ACCOUNT_REFERENCE_DEFAULT=PRINTY
MPESA_TRANSACTION_DESC_DEFAULT=Printy payment
# For future B2C / reversal / status flows (optional, leave empty for now):
# MPESA_INITIATOR_NAME=
# MPESA_INITIATOR_PASSWORD=
# MPESA_SECURITY_CREDENTIAL=
# MPESA_TIMEOUT_URL=https://api.printy.ke/api/payments/mpesa/timeout/
# MPESA_RESULT_URL=https://api.printy.ke/api/payments/mpesa/result/

# --- Optional OAuth ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=