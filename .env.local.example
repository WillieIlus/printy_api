# Printy backend — localhost development template.
# Copy to .env for local development.

SECRET_KEY=dev-only-secret-key-change-me-later
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
FRONTEND_URL=http://localhost:3000
SITE_DOMAIN=localhost:8000
SITE_NAME=Printy

DB_NAME=printy_dev
DB_USER=printy_dev
DB_PASSWORD=printy_dev_pw
DB_HOST=127.0.0.1
DB_PORT=5432

# Console backend prints emails to the terminal (no SMTP needed).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
ACCOUNT_EMAIL_VERIFICATION=mandatory

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://localhost:8000

MPESA_ENV=sandbox
MPESA_SIMULATE_STK_PUSH=true
MPESA_AUTO_CONFIRM_STK_PUSH=false