# Printy backend — localhost development template.
# Copy to .env for local development.

SECRET_KEY=dev-only-secret-key-change-me-later
DEBUG=true
# Marks this environment as local so the email guard (printy.E001) stays green
# while the console backend is in use. Production MUST use APP_ENV=production.
APP_ENV=local
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
FRONTEND_URL=http://localhost:3000
SITE_DOMAIN=localhost:8000
SITE_NAME=Printy

DB_NAME=printy_dev
DB_USER=printy_dev
DB_PASSWORD=printy_dev_pw
DB_HOST=127.0.0.1
DB_PORT=5432

# Console backend prints emails to the terminal (no SMTP needed).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
ACCOUNT_EMAIL_VERIFICATION=mandatory

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://localhost:8000

# Sandbox Daraja — never point a local dev .env at MPESA_ENV=production unless
# you have real keys ready; the guard printy.E013–E016 then fails startup.
# A public tunnel callback (e.g. ngrok) is required for real sandbox callbacks.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=replace-with-sandbox-consumer-key
MPESA_CONSUMER_SECRET=replace-with-sandbox-consumer-secret
# Daraja product the app is provisioned for: paybill | till | buygoodsonline.
# A Daraja app is provisioned for exactly ONE product, and sending the wrong
# TransactionType is rejected as "Invalid TransactionType".
MPESA_SHORTCODE_TYPE=paybill
# paybill/till only: leave both empty for buygoodsonline, which is authorised
# by the OAuth token alone and rejects a short code or password.
MPESA_SHORTCODE=174379
MPESA_PASSKEY=replace-with-sandbox-passkey
MPESA_CALLBACK_URL=https://api.printy.ke/api/payments/mpesa/callback/